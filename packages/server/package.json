{
	"name": "@code-yeongyu/senpi-server",
	"version": "2026.9.4",
	"description": "experimental server package for senpi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./unix": {
			"types": "./dist/transports/unix/index.d.ts",
			"import": "./dist/transports/unix/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsc -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"senpi",
		"server"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/senpi.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^2026.9.4",
		"@earendil-works/pi-protocol": "^2026.9.4"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.11"
	},
	"private": true
}
