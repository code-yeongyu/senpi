{
	"name": "@code-yeongyu/senpi-desktop-engine",
	"private": true,
	"version": "2026.9.24-2",
	"description": "Locator, ABI handshake, and vendored host prebuild for the senpi-desktop-engine binary",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./native": {
			"types": "./native/index.d.ts",
			"import": "./native/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"native",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run test",
		"check:prebuild": "node native/check-prebuild-fresh.mjs",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"senpi",
		"desktop",
		"computer-use"
	],
	"author": "Yeongyu Kim",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/senpi.git",
		"directory": "packages/desktop-engine"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"dependencies": {
		"@code-yeongyu/senpi-desktop-protocol": "^2026.9.24-2"
	},
	"devDependencies": {
		"@types/node": "26.6.2",
		"zod": "4.6.5"
	}
}
