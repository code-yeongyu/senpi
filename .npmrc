save-exact=true
min-release-age=2
; first-party workspace packages released by this repo's own publish workflow must not be gated by min-release-age
min-release-age-exclude[]=@code-yeongyu/*
; @anthropic-ai/sdk 0.123.0 required by the 2026-09-03 upstream sync; remove after 2026-09-05
min-release-age-exclude[]=@anthropic-ai/sdk
min-release-age-exclude[]=@hono/node-server
min-release-age-exclude[]=@anthropic-ai/claude-agent-sdk
min-release-age-exclude[]=@aws-sdk/*
min-release-age-exclude[]=@google/genai
min-release-age-exclude[]=@smithy/*
min-release-age-exclude[]=typebox
min-release-age-exclude[]=vite
