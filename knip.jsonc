  "workspaces": {
    ".": {
      "project": ["scripts/**/*.{js,mjs,cjs,ts,mts}"],
      "entry": [
        // Root scripts are run by path (package.json scripts, CI workflows, release docs).
        "scripts/*.{js,mjs,ts}",
        "scripts/qa/*.{mjs,ts}",
        "scripts/qa/fixtures/*.mjs",
        "scripts/oxlint/*.{mjs,ts}",
        // These sidecars type an .mjs module for its importers and tests.
        "scripts/**/*.d.mts",
      ],
      "includeEntryExports": true,
    },
    ".agents/skills/senpi-qa": {
      // A private dependency island outside the npm workspaces (its own package.json).
      "project": ["scripts/**/*.{js,mjs,cjs,ts,mts}"],
      // Every QA driver is run by path (node .agents/skills/senpi-qa/scripts/<driver>.mjs), including
      // scenarios/*.mjs and drivers added later under any subdirectory.
      "entry": ["scripts/**/*.{mjs,ts}"],
      "includeEntryExports": true,
      "ignoreIssues": {
        // pre-existing at origin main aceb1cc1d9: imports of undeclared packages @anthropic-ai/claude-agent-sdk; imports that do not resolve ../../../packages/coding-agent/src/core/extensions/builtin/anthropic-subscription/executable.ts
