{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exported types are part of our contracts even before they have consumers.
  "rules": { "types": "off", "nsTypes": "off" },
  // These executables are supplied by the OS, a language toolchain, or a test that expects a missing command.
  "ignoreBinaries": [
    "cc", "hdiutil", "julia", "mkfifo", "mount", "ollama", "perl", "pgrep", "rg", "ruby", "script",
    "senpi-deliberately-missing-probe-command", "taskkill.exe", "tasklist", "trash", "vmmap", "where", "xclip",
  ],
  // Findings marked "pre-existing at origin main aceb1cc1d9" were already present when this check was added. Each
  // ignore is scoped to one file or one dependency, so new dead code anywhere else still fails the check. Remove an
  // entry when its finding is fixed. Unused exports are ignored file-wide only on generated files (and on a vendored file
  // only when its bytes are pinned and it is not edited here; none today). Every other file's are listed by name under
  // preprocessorOptions.preExistingExports below, so a new unused export in the same file still fails.
  // Root-workspace file ignores (knip reads the root workspace's ignoreIssues only at the top level).
  "ignoreIssues": {
      // pre-existing at origin main aceb1cc1d9: imports of undeclared packages yaml
