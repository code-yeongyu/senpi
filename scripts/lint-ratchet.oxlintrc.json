{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "jsPlugins": [
    "./oxlint/testing.mjs"
  ],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-non-null-assertion": "error",
    "senpi-testing/no-fixed-sleep": "error",
    "senpi-testing/no-flake-masking": "error",
    "senpi-testing/no-module-mock": "error"
  }
}